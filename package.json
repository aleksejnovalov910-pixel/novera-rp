{
  "name": "novera-rp",
  "version": "0.14.0",
  "private": true,
  "description": "NOVERA RP — next-generation GTA V Role Play server for RAGE:MP",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --parallel -r dev",
    "db:migrate": "pnpm --filter @novera/database migrate",
    "db:check": "pnpm --filter @novera/database typecheck",
    "runtime:build": "pnpm typecheck && node scripts/build-runtime.mjs",
    "runtime:validate": "node scripts/validate-runtime.mjs"
  },
  "devDependencies": { "esbuild": "^0.25.9" },
  "engines": { "node": ">=18.0.0" }
}
