{
  "name": "novera-rp",
  "version": "0.2.0",
  "private": true,
  "description": "NOVERA RP — next-generation GTA V Role Play server for RAGE:MP",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --parallel -r dev",
    "db:migrate": "pnpm --filter @novera/database migrate",
    "db:check": "pnpm --filter @novera/database typecheck"
  },
  "engines": { "node": ">=22.0.0" }
}
