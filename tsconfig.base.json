{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "baseUrl": ".",
    "paths": {
      "@novera/shared": ["packages/shared/src/index.ts"],
      "@novera/config": ["packages/config/src/index.ts"],
      "@novera/database": ["packages/database/src/index.ts"],
      "@novera/logging": ["packages/logging/src/index.ts"]
    }
  }
}
